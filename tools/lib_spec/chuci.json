  {
   "id": "chuci_lisao1",
   "t": "离骚（一）：帝高阳之苗裔",
   "a": "屈原《离骚》",
   "why": "身世自叙与美政理想的起点，“灵修”“美人”的政治隐喻由此展开",
   "passages": [
    {
     "kind": "span",
     "file": "楚辞.txt",
     "after": 4,
     "start": "帝高阳之苗裔兮，朕皇考曰伯庸。",
     "end": "余既不难夫离别兮，伤灵修之数化。"
    }
   ]
  },
  {
   "id": "chuci_lisao2",
   "t": "离骚（二）：滋兰之九畹",
   "a": "屈原《离骚》",
   "why": "种兰喻育才，“长太息以掩涕兮”“虽九死其犹未悔”两句最见立场",
   "passages": [
    {
     "kind": "span",
     "file": "楚辞.txt",
     "after": 29,
     "start": "余既滋兰之九畹兮，又树蕙之百亩。",
     "end": "宁溘死以流亡兮，余不忍为此态也。"
    }
   ]
  },
  {
   "id": "chuci_lisao3",
   "t": "离骚（三）：鸷鸟之不群",
   "a": "屈原《离骚》",
   "why": "“进不入以离尤兮，退将复修吾初服”的进退抉择与女嬃的劝诫",
   "passages": [
    {
     "kind": "span",
     "file": "楚辞.txt",
     "after": 53,
     "start": "鸷鸟之不群兮，自前世而固然。",
     "end": "依前圣以节中兮，喟凭心而历兹。"
    }
   ]
  },
  {
   "id": "chuci_lisao4",
   "t": "离骚（四）：就重华而敶词",
   "a": "屈原《离骚》",
   "why": "借向舜陈词，把个人遭遇放进夏商周兴亡的史鉴之中",
   "passages": [
    {
     "kind": "span",
     "file": "楚辞.txt",
     "after": 76,
     "start": "济沅、湘以南征兮，就重华而敶词：",
     "end": "跪敷衽以陈辞兮，耿吾既得此中正。"
    }
   ]
  },
  {
   "id": "chuci_lisao5",
   "t": "离骚（五）：上征与求女",
   "a": "屈原《离骚》",
   "why": "“上下求索”的神游主线开始，天阍不开、宓妃弃去",
   "passages": [
    {
     "kind": "span",
     "file": "楚辞.txt",
     "after": 97,
     "start": "驷玉虬以桀鹥兮，溘埃风余上征。",
     "end": "虽信美而无礼兮，来违弃而改求。"
    }
   ]
  },
  {
   "id": "chuci_lisao6",
   "t": "离骚（六）：有娀与灵氛",
   "a": "屈原《离骚》",
   "why": "求女受挫后的转折，灵氛劝去国远游",
   "passages": [
    {
     "kind": "span",
     "file": "楚辞.txt",
     "after": 122,
     "start": "览相观于四极兮，周流乎天余乃下。",
     "end": "欲从灵氛之吉占兮，心犹豫而狐疑。"
    }
   ]
  },
  {
   "id": "chuci_lisao7",
   "t": "离骚（七）：巫咸降神",
   "a": "屈原《离骚》",
   "why": "去与留的两难，兰芷荃蕙“化而为茅”的痛切",
   "passages": [
    {
     "kind": "span",
     "file": "楚辞.txt",
     "after": 145,
     "start": "巫咸将夕降兮，怀椒糈而要之。",
     "end": "及余饰之方壮兮，周流观乎上下。"
    }
   ]
  },
  {
   "id": "chuci_lisao8",
   "t": "离骚（八）：远逝与乱辞",
   "a": "屈原《离骚》",
   "why": "全篇结尾，远逝终被乡情拽回，乱辞以“从彭咸之所居”收束",
   "passages": [
    {
     "kind": "span",
     "file": "楚辞.txt",
     "after": 172,
     "start": "灵氛既告余以吉占兮，历吉日乎吾将行。",
     "end": "既莫足与为美政兮，吾将从彭咸之所居！"
    }
   ]
  },
